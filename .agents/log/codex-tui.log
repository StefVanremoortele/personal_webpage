 :root {
   --background: #ffffff;
   --foreground: #171717;
+  --ambient-grid: rgba(15, 23, 42, 0.045);
+  --ambient-line: rgba(15, 23, 42, 0.06);
+  --ambient-accent-a: rgba(14, 165, 233, 0.08);
+  --ambient-accent-b: rgba(245, 158, 11, 0.055);
+  --ambient-vignette: rgba(255, 255, 255, 0.86);
 }
 
 .dark {
   --background: #0a0a0a;
   --foreground: #ededed;
+  --ambient-grid: rgba(34, 197, 94, 0.105);
+  --ambient-line: rgba(45, 212, 191, 0.11);
+  --ambient-accent-a: rgba(34, 211, 238, 0.14);
+  --ambient-accent-b: rgba(251, 191, 36, 0.095);
+  --ambient-vignette: rgba(10, 10, 10, 0.92);
 }
@@
 html, body {
-  background: var(--background);
   color: var(--foreground);
 }
 
+html {
+  background: var(--background);
+}
+
 body {
+  position: relative;
+  isolation: isolate;
+  background:
+    radial-gradient(circle at 50% 0%, transparent 0 34rem, var(--ambient-vignette) 72rem),
+    var(--background);
   font-family: var(--font-sans), Arial, Helvetica, sans-serif;
   -webkit-font-smoothing: antialiased;
 }
+
+body::before,
+body::after {
+  pointer-events: none;
+  content: "";
+  position: fixed;
+  inset: 0;
+  z-index: -1;
+}
+
+body::before {
+  background:
+    radial-gradient(circle at 18% 14%, var(--ambient-accent-a), transparent 27rem),
+    radial-gradient(circle at 82% 18%, var(--ambient-accent-b), transparent 22rem),
+    radial-gradient(circle at 64% 76%, var(--ambient-accent-a), transparent 28rem),
+    linear-gradient(115deg, transparent 0 24%, var(--ambient-line) 24.15% 24.35%, transparent 24.5% 100%),
+    linear-gradient(65deg, transparent 0 62%, var(--ambient-line) 62.1% 62.28%, transparent 62.45% 100%);
+  opacity: 0.85;
+}
+
+body::after {
+  background-image:
+    repeating-linear-gradient(0deg, transparent 0 38px, var(--ambient-grid) 39px, transparent 40px),
+    repeating-linear-gradient(90deg, transparent 0 38px, var(--ambient-grid) 39px, transparent 40px),
+    linear-gradient(135deg, transparent 0 18%, var(--ambient-line) 18.1% 18.25%, transparent 18.4% 44%, var(--ambient-line) 44.1% 44.22%, transparent 44.35% 100%),
+    linear-gradient(45deg, transparent 0 70%, var(--ambient-line) 70.1% 70.25%, transparent 70.4% 100%);
+  background-position:
+    center,
+    center,
+    0 0,
+    0 0;
+  background-size:
+    40px 40px,
+    40px 40px,
+    21rem 21rem,
+    17rem 17rem;
+  mask-image: radial-gradient(ellipse at center, black 0 58%, transparent 86%);
+  opacity: 0.32;
+}
